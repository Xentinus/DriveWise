@* Partial for Settings card *@
<div class="settings-card card p-3">
    <p class="settings-title">Alapbeállítások</p>

    <div class="settings-item">
        <div class="settings-label">Értesítések</div>
        <div class="settings-value">
            <label class="switch">
                <input type="checkbox" data-storage-key="notifications" />
                <span class="switch-slider" aria-hidden="true"></span>
            </label>
        </div>
    </div>

    <p class="settings-title">Téma</p>
    <div class="settings-item">
        <div class="settings-label">Megjelenés</div>
        <div class="settings-value">
            <select id="themeSelect" data-storage-key="theme" class="form-select form-select-sm" aria-label="Téma">
                <option value="light">Világos</option>
                <option value="dark">Sötét</option>
            </select>
        </div>
    </div>

    <p class="settings-title">Mértékegység</p>
    <div class="settings-item">
        <div class="settings-label">Választás</div>
        <div class="settings-value">
            <select id="unitSelect" data-storage-key="unit" class="form-select form-select-sm" aria-label="Mértékegység">
                <option value="0">Metrikus</option>
                <option value="1">Angolszász</option>
            </select>
        </div>
    </div>

    <p class="settings-title">Pénznem</p>
    <div class="settings-item">
        <div class="settings-label">Valuta</div>
        <div class="settings-value">
            <select id="currencySelect" data-storage-key="currency" class="form-select form-select-sm" aria-label="Pénznem">
                <option value="EUR">EUR — Euro</option>
                <option value="GBP">GBP — British Pound</option>
                <option value="CHF">CHF — Swiss Franc</option>
                <option value="PLN">PLN — Polish Zloty</option>
                <option value="HUF">HUF — Hungarian Forint</option>
                <option value="CZK">CZK — Czech Koruna</option>
                <option value="SEK">SEK — Swedish Krona</option>
                <option value="NOK">NOK — Norwegian Krone</option>
                <option value="DKK">DKK — Danish Krone</option>
            </select>
        </div>
    </div>

    <p class="settings-title">Adatok kezelése</p>
    <div class="settings-item">
        <div class="settings-label">Összes adat törlése</div>
        <div class="settings-value">
            <button type="button" id="clearAllDataBtn" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-exclamation-triangle"></i> Reset
            </button>
        </div>
    </div>

    <p class="settings-title">Névjegy</p>
    <div class="settings-item">
        <div class="settings-label">Fejlesztő</div>
        <div class="settings-value">
            <a href="https://github.com/Xentinus" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                <i class="bi bi-github"></i> Xentinus
            </a>
        </div>
    </div>
    <div class="settings-item">
        <div class="settings-label">Térkép adatok</div>
        <div class="settings-value">
            <small class="text-muted" id="map-attribution" style="text-align: right; display: block; width: 100%; font-size: 0.75rem;">
                
            </small>
        </div>
    </div>
</div>

<script>
(function() {
    function init() {
        console.log('[settings] init');
        
        // Set sensible defaults before storage initialization
        setDefaults();
        
        // Sync with current theme state
        syncCurrentTheme();
        
        // Debug: Check what's in storage before initialization
        console.log('[settings] Storage contents before init:');
        console.log('[settings] theme:', StorageManager.get('theme'));
        console.log('[settings] unit:', StorageManager.get('unit'));
        console.log('[settings] currency:', StorageManager.get('currency'));
        console.log('[settings] notifications:', StorageManager.get('notifications'));
        
        // Use the global StorageManager for form element initialization
        StorageManager.initFormStorage();
        
        // Debug: Check what's in storage after initialization
        console.log('[settings] Storage contents after init:');
        console.log('[settings] theme:', StorageManager.get('theme'));
        console.log('[settings] unit:', StorageManager.get('unit'));
        console.log('[settings] currency:', StorageManager.get('currency'));
        console.log('[settings] notifications:', StorageManager.get('notifications'));
        
        // Update map attribution text in settings
        updateMapAttribution();
        
        // Initialize data management functionality
        initDataManagement();
        
        // Special event dispatching for theme and unit changes
        window.addEventListener('storageChanged', function(event) {
            const { key, value } = event.detail;
            
            if (key === 'unit') {
                try {
                    window.dispatchEvent(new CustomEvent('unitChanged', { detail: { unit: Number(value) } }));
                } catch (e) { 
                    console.warn('[settings] dispatch unitChanged failed', e); 
                }
            }
            
            if (key === 'theme') {
                try {
                    // Notify ThemeManager about theme change
                    if (window.ThemeManager) {
                        window.ThemeManager.setTheme(value);
                    }
                    window.dispatchEvent(new CustomEvent('themeChanged', { detail: { theme: value } }));
                } catch (e) { 
                    console.warn('[settings] dispatch themeChanged failed', e); 
                }
            }
        });
    }

    function initDataManagement() {
        const clearAllDataBtn = document.getElementById('clearAllDataBtn');
        
        if (clearAllDataBtn) {
            clearAllDataBtn.addEventListener('click', function() {
                clearAllData();
            });
        }
    }

    function clearAllData() {
        // Show confirmation dialog
        const confirmed = confirm('Biztosan törölni szeretnéd az összes mentett adatot? Ez visszaállítja az alkalmazást az alapértelmezett állapotba.\n\nTörölve lesz:\n- Beállítások\n- Járművek\n- Keresési előzmények\n- Tárolt adatok');
        
        if (!confirmed) {
            return;
        }
        
        try {
            // Show loading state
            const btn = document.getElementById('clearAllDataBtn');
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-arrow-clockwise spin"></i> Törlés...';
            btn.disabled = true;
            
            // Clear localStorage
            try {
                localStorage.clear();
                console.log('[settings] localStorage cleared');
            } catch (e) {
                console.warn('[settings] localStorage clear failed:', e);
            }
            
            // Clear sessionStorage
            try {
                sessionStorage.clear();
                console.log('[settings] sessionStorage cleared');
            } catch (e) {
                console.warn('[settings] sessionStorage clear failed:', e);
            }
            
            // Clear IndexedDB if available
            if ('indexedDB' in window) {
                try {
                    // Common database names used by apps
                    const dbNames = ['DriveWise', 'vehicles', 'settings', 'cache'];
                    dbNames.forEach(dbName => {
                        const deleteReq = indexedDB.deleteDatabase(dbName);
                        deleteReq.onsuccess = () => console.log('[settings] IndexedDB cleared:', dbName);
                        deleteReq.onerror = () => console.warn('[settings] IndexedDB clear failed:', dbName);
                    });
                } catch (e) {
                    console.warn('[settings] IndexedDB clear failed:', e);
                }
            }
            
            setTimeout(() => {
                btn.innerHTML = '<i class="bi bi-check"></i> Törölve';
                btn.classList.remove('btn-outline-danger');
                btn.classList.add('btn-outline-success');
                
                // Force complete page reload with cache busting
                setTimeout(() => {
                    window.location.href = window.location.protocol + '//' + window.location.host + window.location.pathname + '?_reset=' + Date.now();
                }, 1000);
            }, 1500);
            
        } catch (error) {
            console.error('[settings] Data clearing error:', error);
            
            const btn = document.getElementById('clearAllDataBtn');
            btn.innerHTML = '<i class="bi bi-x"></i> Hiba';
            btn.disabled = false;
            
            setTimeout(() => {
                btn.innerHTML = '<i class="bi bi-exclamation-triangle"></i> Reset';
            }, 3000);
        }
    }

    function syncCurrentTheme() {
        // Ensure the theme select shows the actual current theme
        if (window.ThemeManager) {
            const currentTheme = window.ThemeManager.getCurrentTheme();
            const themeSelect = document.getElementById('themeSelect');
            if (themeSelect && currentTheme) {
                themeSelect.value = currentTheme;
                // Also update the storage to ensure consistency
                StorageManager.set('theme', currentTheme);
                console.log('[settings] synced current theme:', currentTheme);
            }
        }
    }

    function setDefaults() {
        // Set sensible default values for form elements if none exist in storage
        const defaults = {
            'notifications': true,
            'theme': 'light',
            'unit': '0',  // Metrikus
            'currency': 'HUF'
        };

        // Special handling for theme - get current theme from ThemeManager if available
        if (window.ThemeManager) {
            defaults.theme = window.ThemeManager.getCurrentTheme();
            console.log('[settings] Using current theme from ThemeManager:', defaults.theme);
        }

        Object.keys(defaults).forEach(key => {
            const element = document.querySelector(`[data-storage-key="${key}"]`);
            if (element) {
                if (element.type === 'checkbox') {
                    element.checked = defaults[key];
                } else {
                    element.value = defaults[key];
                }
                console.log('[settings] set default for', key, '=', defaults[key]);
            }
        });
    }

    function updateMapAttribution() {
        // Get the complete attribution from map layers
        const attributionText = '© <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> contributors © <a href="https://carto.com/attributions" target="_blank" rel="noopener noreferrer">CARTO</a>';
        
        const attributionElement = document.getElementById('map-attribution');
        if (attributionElement) {
            attributionElement.innerHTML = attributionText;
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
</script>
