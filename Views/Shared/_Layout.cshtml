<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    
    <!-- Enhanced Cache Control - Prevent All Caching -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate, max-age=0" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <meta http-equiv="Last-Modified" content="0" />
    <meta http-equiv="If-Modified-Since" content="0" />
    <meta http-equiv="Etag" content="0" />
    
    <!-- Primary Meta Tags -->
    <title>DriveWise - Intelligens Útitárs</title>
    <meta name="title" content="DriveWise - Intelligens Útitárs" />
    <meta name="description" content="Intelligens térképes navigációs alkalmazás időjárás előrejelzéssel és járműkezeléssel" />
    <meta name="keywords" content="navigáció, térkép, időjárás, autó, útvonaltervezés, GPS" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="Hungarian" />
    <meta name="author" content="Xentinus" />
    
    <!-- PWA Meta Tags -->
    <meta name="application-name" content="DriveWise" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="DriveWise" />
    <meta name="msapplication-TileColor" content="#2563eb" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta name="theme-color" content="#2563eb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1e40af" media="(prefers-color-scheme: dark)" />
    
    <!-- Web App Manifest -->
    <link rel="manifest" href="/manifest.json" />
    
    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/icon.svg" />
    
    <!-- Microsoft Tiles -->
    <meta name="msapplication-TileImage" content="/icons/icon.svg" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="/" />
    <meta property="og:title" content="DriveWise - Intelligens Útitárs" />
    <meta property="og:description" content="Intelligens térképes navigációs alkalmazás időjárás előrejelzéssel és járműkezeléssel" />
    <meta property="og:image" content="/icons/icon.svg" />
    <meta property="og:site_name" content="DriveWise" />
    <meta property="og:locale" content="hu_HU" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="/" />
    <meta property="twitter:title" content="DriveWise - Intelligens Útitárs" />
    <meta property="twitter:description" content="Intelligens térképes navigációs alkalmazás időjárás előrejelzéssel és járműkezeléssel" />
    <meta property="twitter:image" content="/icons/icon.svg" />
    
    <!-- Google Fonts Preconnect for Performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- Google Fonts: Nunito with full variable font range -->
    <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS (design framework) with cache busting -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="" crossorigin="anonymous">
    <!-- Bootstrap Icons (for modern icons) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Leaflet (OpenStreetMap) CSS from CDN to avoid missing local files -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="" crossorigin="" />
    
    <!-- Local CSS files with cache busting parameters -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modal-manager.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/map.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/route-card.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/plan-card.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/weather-widget.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pwa.css" asp-append-version="true" />
    
    <!-- Cache busting script -->
    <script>
        // Add cache busting timestamp to all local resource requests
        (function() {
            const timestamp = new Date().getTime();
            const links = document.querySelectorAll('link[href*="~/"]');
            links.forEach(link => {
                if (link.href.indexOf('?') === -1) {
                    link.href += '?v=' + timestamp;
                } else {
                    link.href += '&v=' + timestamp;
                }
            });
        })();
    </script>
</head>
<body>
    <!-- Cache Clear Notification -->
    <div id="cacheNotification" class="cache-notification" style="display: none;">
        <div class="cache-notification-content">
            <i class="bi bi-arrow-clockwise spin"></i>
        </div>
    </div>

    <div id="map"></div>
    
    <!-- Unified Top-Left Widget -->
    <div class="unified-top-widget">
        <!-- Zoom Controls -->
        <div class="zoom-controls">
            <button type="button" class="zoom-btn" id="zoomIn" title="Nagyítás">
                +
            </button>
            <button type="button" class="zoom-btn" id="zoomOut" title="Kicsinyítés">
                −
            </button>
        </div>
        
        <!-- Weather Widget -->
        <div class="weather-controls">
            <div id="weatherWidget" class="weather-widget-content">
                <div class="weather-loading">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Betöltés...</span>
                    </div>
                    <span>Időjárás...</span>
                </div>
            </div>
        </div>
        
        <!-- Search Controls -->
        <div class="search-controls">
            <div class="search-input-group">
                <i class="bi bi-search search-icon"></i>
                <input type="text" id="locationSearch" class="search-input" placeholder="Keresés címek között..." autocomplete="off">
                <button type="button" id="clearSearch" class="clear-search-btn" style="display: none;">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div id="searchResults" class="search-results" style="display: none;"></div>
        </div>
    </div>
    
    @RenderBody()

    <!-- Route Card -->
    @await Html.PartialAsync("_RouteCard")

    <!-- Button-nav v2: centered, modern, responsive -->
    <footer class="bottom-nav v2" role="navigation" aria-label="Fő navigáció">
        <div class="nav-wrap">
            <ul class="nav d-flex align-items-center m-0 p-0">
                <li class="nav-item">
                    <a href="#" class="nav-link nav-btn" id="vehiclesBtn" aria-label="Járművek">
                        <i class="bi bi-truck" aria-hidden="true"></i>
                        <span>Járművek</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a href="#" class="nav-link nav-btn center" id="planBtn" aria-label="Tervezés">
                        <i class="bi bi-compass" aria-hidden="true"></i>
                        <span>Tervezés</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a href="#" class="nav-link nav-btn" id="settingsBtn" aria-label="Beállítások">
                        <i class="bi bi-gear" aria-hidden="true"></i>
                        <span>Beállítások</span>
                    </a>
                </li>
            </ul>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="" crossorigin="anonymous"></script>
    <!-- Leaflet JS (must load before map.js) -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="" crossorigin=""></script>
    
    <!-- Local JS files with cache busting parameters -->
    <script src="~/js/storage-manager.js" asp-append-version="true"></script>
    <script src="~/js/theme-manager.js" asp-append-version="true"></script>
    <script src="~/js/pwa.js" asp-append-version="true"></script>
    <script src="~/js/map.js" asp-append-version="true"></script>
    <script src="~/js/search.js" asp-append-version="true"></script>
    <script src="~/js/navigation.js" asp-append-version="true"></script>
    <script src="~/js/bottom-nav.js" asp-append-version="true"></script>
    <script src="~/js/modal-manager.js" asp-append-version="true"></script>
    <script src="~/js/plan-card.js" asp-append-version="true"></script>
    <script src="~/js/weather-widget.js" asp-append-version="true"></script>
    
    <!-- F5 Cache Clear Handler -->
    <script>
        // Global F5 cache clearing functionality
        (function() {
            let lastF5Press = 0;
            const F5_COOLDOWN = 2000; // 2 seconds cooldown to prevent spam
            
            document.addEventListener('keydown', function(event) {
                // Check if F5 (key code 116) is pressed
                if (event.key === 'F5' || event.keyCode === 116) {
                    const now = Date.now();
                    
                    // Prevent spam pressing
                    if (now - lastF5Press < F5_COOLDOWN) {
                        return;
                    }
                    
                    lastF5Press = now;
                    
                    // Prevent default F5 behavior temporarily
                    event.preventDefault();
                    
                    console.log('[F5Handler] F5 pressed - clearing cache...');
                    
                    // Show notification only during clearing
                    showCacheNotification();
                    
                    // Clear cache using StorageManager
                    if (window.StorageManager) {
                        Promise.all([
                            window.StorageManager.clearCache(),
                            // Also clear service worker cache if available
                            clearServiceWorkerCache()
                        ]).then(function() {
                            console.log('[F5Handler] Cache cleared successfully');
                            
                            // Hide notification immediately and refresh
                            hideCacheNotification();
                            
                            // Refresh the page with cache busting immediately
                            setTimeout(function() {
                                window.location.href = window.location.protocol + '//' + 
                                    window.location.host + window.location.pathname + 
                                    '?_cache_clear=' + Date.now();
                            }, 200);
                            
                        }).catch(function(error) {
                            console.error('[F5Handler] Cache clearing failed:', error);
                            hideCacheNotification();
                            
                            // Still refresh the page even if cache clear failed
                            setTimeout(function() {
                                window.location.reload(true);
                            }, 300);
                        });
                    } else {
                        console.warn('[F5Handler] StorageManager not available, performing regular refresh');
                        hideCacheNotification();
                        window.location.reload(true);
                    }
                }
            });
            
            function clearServiceWorkerCache() {
                return new Promise(function(resolve) {
                    if ('serviceWorker' in navigator && 'caches' in window) {
                        navigator.serviceWorker.getRegistrations().then(function(registrations) {
                            const updatePromises = registrations.map(function(registration) {
                                // Force update the service worker
                                return registration.update().catch(function(error) {
                                    console.warn('[F5Handler] Service worker update failed:', error);
                                });
                            });
                            
                            return Promise.all(updatePromises);
                        }).then(function() {
                            console.log('[F5Handler] Service worker cache cleared');
                            resolve();
                        }).catch(function(error) {
                            console.warn('[F5Handler] Service worker cache clear failed:', error);
                            resolve(); // Don't fail the whole operation
                        });
                    } else {
                        resolve();
                    }
                });
            }
            
            function showCacheNotification() {
                const notification = document.getElementById('cacheNotification');
                if (notification) {
                    notification.style.display = 'flex';
                    notification.style.opacity = '1';
                }
            }
            
            function hideCacheNotification() {
                const notification = document.getElementById('cacheNotification');
                if (notification) {
                    notification.style.opacity = '0';
                    setTimeout(function() {
                        notification.style.display = 'none';
                    }, 200);
                }
            }
        })();
    </script>
    
    <!-- PWA Service Worker Registration -->
    <script>
        // Register Service Worker for PWA functionality
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js?v=' + new Date().getTime())
                    .then(registration => {
                        console.log('ServiceWorker registration successful');
                    })
                    .catch(error => {
                        console.log('ServiceWorker registration failed: ', error);
                    });
            });
        }
        
        // Add cache busting to dynamically loaded scripts
        (function() {
            const timestamp = new Date().getTime();
            const scripts = document.querySelectorAll('script[src*="~/"]');
            scripts.forEach(script => {
                if (script.src.indexOf('?') === -1) {
                    script.src += '?v=' + timestamp;
                } else {
                    script.src += '&v=' + timestamp;
                }
            });
        })();
        
        // Prevent zoom and scroll behavior
        (function() {
            // Prevent zoom with keyboard shortcuts
            document.addEventListener('keydown', function(e) {
                // Disable Ctrl+Plus, Ctrl+Minus, Ctrl+0 (zoom shortcuts)
                if ((e.ctrlKey || e.metaKey) && (e.keyCode === 61 || e.keyCode === 107 || e.keyCode === 173 || e.keyCode === 109 || e.keyCode === 187 || e.keyCode === 189 || e.keyCode === 48)) {
                    e.preventDefault();
                    return false;
                }
            });
            
            // Prevent zoom with mouse wheel
            document.addEventListener('wheel', function(e) {
                if (e.ctrlKey || e.metaKey) {
                    e.preventDefault();
                    return false;
                }
            }, { passive: false });
            
            // Prevent zoom with touch gestures
            document.addEventListener('touchstart', function(e) {
                if (e.touches.length > 1) {
                    e.preventDefault();
                    return false;
                }
            }, { passive: false });
            
            document.addEventListener('touchmove', function(e) {
                if (e.touches.length > 1) {
                    e.preventDefault();
                    return false;
                }
            }, { passive: false });
            
            // Prevent scroll behavior on body
            document.addEventListener('scroll', function(e) {
                window.scrollTo(0, 0);
            }, { passive: false });
            
            document.addEventListener('touchmove', function(e) {
                // Allow touch move only on map element and its children
                if (!e.target.closest('#map') && !e.target.closest('.leaflet-container') && !e.target.closest('.search-results') && !e.target.closest('.modal')) {
                    e.preventDefault();
                    return false;
                }
            }, { passive: false });
            
            // Prevent context menu on long press
            document.addEventListener('contextmenu', function(e) {
                if (!e.target.closest('#map')) {
                    e.preventDefault();
                    return false;
                }
            });
            
            // Prevent double-tap zoom
            let lastTouchEnd = 0;
            document.addEventListener('touchend', function(e) {
                const now = (new Date()).getTime();
                if (now - lastTouchEnd <= 300) {
                    e.preventDefault();
                }
                lastTouchEnd = now;
            }, { passive: false });
        })();
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>