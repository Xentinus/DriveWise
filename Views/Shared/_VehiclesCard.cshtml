@* Combined Vehicles and Vehicle Form cards *@
<div class="vehicles-container">
    @* Main vehicles list card *@
    <div class="vehicles-card card p-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <p class="settings-title mb-0">Járműveim</p>
            <button type="button" class="btn btn-primary btn-sm" id="addVehicleBtn">
                <i class="bi bi-plus"></i> Új jármű
            </button>
        </div>

        <!-- Vehicle List -->
        <div id="vehiclesList" class="vehicles-list">
            <!-- Vehicles will be loaded here dynamically -->
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="text-center py-4 text-muted" style="display: none;">
            <i class="bi bi-car-front fs-1 mb-2"></i>
            <p>Még nincs mentett jármű.</p>
            <p class="small">Kattints az "Új jármű" gombra a hozzáadáshoz.</p>
        </div>

        <!-- Storage disclaimer -->
        <div class="mt-3">
            <small class="text-muted">
                <i class="bi bi-info-circle"></i>
                Az adatok a böngésző helyi tárhelyén kerülnek mentésre, nem egy szerverre.
            </small>
        </div>
    </div>

    @* Vehicle form card *@
    <div class="vehicle-form-card card p-3" style="display: none;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="d-flex align-items-center">
                <button type="button" class="btn btn-outline-secondary btn-sm me-2" id="backToVehiclesBtn">
                    <i class="bi bi-arrow-left"></i>
                </button>
                <h5 class="mb-0" id="vehicleFormTitle">Új jármű</h5>
            </div>
        </div>

        <form id="vehicleForm">
            <input type="hidden" id="vehicleIndex" value="-1">
            
            <div class="mb-3">
                <label for="vehicleName" class="form-label">Név <small class="text-muted">(opciónális)</small></label>
                <input type="text" class="form-control" id="vehicleName" placeholder="pl. Családi autó">
            </div>
            
            <div class="mb-3">
                <label for="vehicleBrand" class="form-label">Jármű márka <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="vehicleBrand" placeholder="pl. Toyota" required>
            </div>

            <div class="mb-3">
                <label for="vehicleModel" class="form-label">Márkán belüli típus <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="vehicleModel" placeholder="pl. Corolla" required>
            </div>
            
            <div class="mb-3">
                <label for="vehicleFuelType" class="form-label">Üzemanyag típus <span class="text-danger">*</span></label>
                <select class="form-select" id="vehicleFuelType" required>
                    <option value="">Válassz...</option>
                    <option value="petrol">Benzin</option>
                    <option value="diesel">Dízel</option>
                    <option value="hybrid">Hibrid</option>
                    <option value="electric">Elektromos</option>
                    <option value="lpg">LPG</option>
                    <option value="cng">CNG</option>
                </select>
            </div>

            <div class="mb-3">
                <label for="vehicleConsumption" class="form-label">Átlagos fogyasztás <span class="text-danger">*</span></label>
                <div class="input-group">
                    <input type="number" class="form-control" id="vehicleConsumption" placeholder="7.5" step="0.1" min="0" required>
                    <span class="consumption-unit input-group-text">L/100km</span>
                </div>
            </div>
            
            <div class="mb-3">
                <label for="vehicleCityConsumption" class="form-label">Városban fogyasztás <small class="text-muted">(opciónális)</small></label>
                <div class="input-group">
                    <input type="number" class="form-control" id="vehicleCityConsumption" placeholder="8.5" step="0.1" min="0">
                    <span class="consumption-unit input-group-text">L/100km</span>
                </div>
            </div>
            
            <div class="mb-3">
                <label for="vehicleHighwayConsumption" class="form-label">Autópályán fogyasztás <small class="text-muted">(opciónális)</small></label>
                <div class="input-group">
                    <input type="number" class="form-control" id="vehicleHighwayConsumption" placeholder="6.5" step="0.1" min="0">
                    <span class="consumption-unit input-group-text">L/100km</span>
                </div>
            </div>

            <div class="mb-3">
                <label for="vehicleYear" class="form-label">Évjárat <span class="text-danger">*</span></label>
                <input type="number" class="form-control" id="vehicleYear" placeholder="2020" min="1900" max="2030" required>
            </div>
            
            <div class="mb-3">
                <label for="vehicleLicensePlate" class="form-label">Rendszám <small class="text-muted">(opciónális)</small></label>
                <input type="text" class="form-control" id="vehicleLicensePlate" placeholder="ABC-123" style="text-transform: uppercase;">
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <button type="button" class="btn btn-secondary" id="cancelVehicleBtn">Mégse</button>
                <button type="button" class="btn btn-primary" id="saveVehicleBtn">Mentés</button>
            </div>
        </form>

        <!-- Storage disclaimer -->
        <div class="mt-3">
            <small class="text-muted">
                <i class="bi bi-info-circle"></i>
                Az adatok a böngésző helyi tárhelyén kerülnek mentésre, nem egy szerverre.
            </small>
        </div>
    </div>
</div>

<script>
(function() {
    'use strict';

    let vehicleForm;
    
    function init() {
        console.log('[vehicles] init');
        
        vehicleForm = document.getElementById('vehicleForm');
        
        // Load vehicles on page load
        loadVehicles();
        
        // Event listeners
        document.getElementById('addVehicleBtn').addEventListener('click', showAddVehicleForm);
        document.getElementById('backToVehiclesBtn').addEventListener('click', goBackToVehicles);
        document.getElementById('cancelVehicleBtn').addEventListener('click', goBackToVehicles);
        document.getElementById('saveVehicleBtn').addEventListener('click', saveVehicle);
        
        // Listen for unit changes to update consumption labels and refresh display
        window.addEventListener('unitChanged', function() {
            updateConsumptionUnits();
            loadVehicles();
        });
        
        // Initialize with current unit setting
        updateConsumptionUnits();
        
        // Auto-uppercase license plate input
        document.getElementById('vehicleLicensePlate').addEventListener('input', function(e) {
            e.target.value = e.target.value.toUpperCase();
        });
    }

    function updateConsumptionUnits() {
        const unit = StorageManager.get('unit', '0');
        const isMetric = unit === '0';
        const unitText = isMetric ? 'L/100km' : 'MPG';
        
        document.querySelectorAll('.consumption-unit').forEach(el => {
            el.textContent = unitText;
        });
    }

    function loadVehicles() {
        const vehicles = StorageManager.getVehicles();
        const vehiclesList = document.getElementById('vehiclesList');
        const emptyState = document.getElementById('emptyState');
        
        if (vehicles.length === 0) {
            vehiclesList.innerHTML = '';
            emptyState.style.display = 'block';
            return;
        }
        
        emptyState.style.display = 'none';
        vehiclesList.innerHTML = vehicles.map((vehicle, index) => createVehicleCard(vehicle, index)).join('');
        
        // Add event listeners to edit and delete buttons
        vehiclesList.querySelectorAll('.edit-vehicle-btn').forEach((btn, index) => {
            btn.addEventListener('click', () => editVehicle(index));
        });
        
        vehiclesList.querySelectorAll('.delete-vehicle-btn').forEach((btn, index) => {
            btn.addEventListener('click', () => deleteVehicle(index));
        });
    }

    function createVehicleCard(vehicle, index) {
        const consumptionInfo = getConsumptionInfo(vehicle);
        const displayName = vehicle.name || `${vehicle.brand} ${vehicle.model}`;
        
        return `
            <div class="vehicle-item border rounded p-3 mb-2">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1">
                        <h6 class="mb-1">${escapeHtml(displayName)}</h6>
                        <div class="small text-muted">
                            <div><strong>Márka:</strong> ${escapeHtml(vehicle.brand)} ${escapeHtml(vehicle.model)}</div>
                            <div><strong>Üzemanyag:</strong> ${getFuelTypeLabel(vehicle.fuelType)}</div>
                            <div><strong>Évjárat:</strong> ${vehicle.year}</div>
                            ${vehicle.licensePlate ? `<div><strong>Rendszám:</strong> ${escapeHtml(vehicle.licensePlate)}</div>` : ''}
                            <div><strong>Fogyasztás:</strong> ${consumptionInfo}</div>
                        </div>
                    </div>
                    <div class="d-flex gap-1">
                        <button type="button" class="btn btn-outline-primary btn-sm edit-vehicle-btn" title="Szerkesztés">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button type="button" class="btn btn-outline-danger btn-sm delete-vehicle-btn" title="Törlés">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        `;
    }

    function getConsumptionInfo(vehicle) {
        const unit = StorageManager.get('unit', '0');
        const isMetric = unit === '0';
        const unitText = isMetric ? 'L/100km' : 'MPG';
        
        let consumption = parseFloat(vehicle.consumption);
        if (!isMetric && vehicle.consumption) {
            // Convert L/100km to MPG: MPG = 235.214 / L/100km
            consumption = (235.214 / consumption).toFixed(1);
        }
        
        if (vehicle.cityConsumption && vehicle.highwayConsumption) {
            let cityConsumption = parseFloat(vehicle.cityConsumption);
            let highwayConsumption = parseFloat(vehicle.highwayConsumption);
            
            if (!isMetric) {
                cityConsumption = (235.214 / cityConsumption).toFixed(1);
                highwayConsumption = (235.214 / highwayConsumption).toFixed(1);
            }
            
            return `${cityConsumption}/${highwayConsumption} ${unitText} (város/autópálya)`;
        }
        
        return `${consumption} ${unitText} (átlag)`;
    }

    function getFuelTypeLabel(fuelType) {
        const labels = {
            'petrol': 'Benzin',
            'diesel': 'Dízel',
            'hybrid': 'Hibrid',
            'electric': 'Elektromos',
            'lpg': 'LPG',
            'cng': 'CNG'
        };
        return labels[fuelType] || fuelType;
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function showAddVehicleForm() {
        resetForm();
        document.getElementById('vehicleFormTitle').textContent = 'Új jármű';
        document.getElementById('vehicleIndex').value = '-1';
        showVehicleForm();
    }

    function editVehicle(index) {
        const vehicles = StorageManager.getVehicles();
        const vehicle = vehicles[index];
        
        if (!vehicle) return;
        
        // Fill form with vehicle data
        document.getElementById('vehicleIndex').value = index;
        document.getElementById('vehicleName').value = vehicle.name || '';
        document.getElementById('vehicleBrand').value = vehicle.brand || '';
        document.getElementById('vehicleModel').value = vehicle.model || '';
        document.getElementById('vehicleFuelType').value = vehicle.fuelType || '';
        document.getElementById('vehicleConsumption').value = vehicle.consumption || '';
        document.getElementById('vehicleCityConsumption').value = vehicle.cityConsumption || '';
        document.getElementById('vehicleHighwayConsumption').value = vehicle.highwayConsumption || '';
        document.getElementById('vehicleYear').value = vehicle.year || '';
        document.getElementById('vehicleLicensePlate').value = vehicle.licensePlate || '';
        
        document.getElementById('vehicleFormTitle').textContent = 'Jármű szerkesztése';
        showVehicleForm();
    }

    function showVehicleForm() {
        const vehiclesCard = document.querySelector('.vehicles-card');
        const vehicleFormCard = document.querySelector('.vehicle-form-card');
        
        vehiclesCard.style.display = 'none';
        vehicleFormCard.style.display = 'block';
    }

    function goBackToVehicles() {
        const vehiclesCard = document.querySelector('.vehicles-card');
        const vehicleFormCard = document.querySelector('.vehicle-form-card');
        
        vehiclesCard.style.display = 'block';
        vehicleFormCard.style.display = 'none';
        
        // Refresh vehicles list
        loadVehicles();
    }

    function deleteVehicle(index) {
        if (confirm('Biztosan törölni szeretnéd ezt a járművet?')) {
            StorageManager.deleteVehicle(index);
            loadVehicles();
        }
    }

    function resetForm() {
        vehicleForm.reset();
        document.getElementById('vehicleIndex').value = '-1';
    }

    function saveVehicle() {
        if (!vehicleForm.checkValidity()) {
            vehicleForm.reportValidity();
            return;
        }
        
        const vehicleData = {
            name: document.getElementById('vehicleName').value.trim(),
            brand: document.getElementById('vehicleBrand').value.trim(),
            model: document.getElementById('vehicleModel').value.trim(),
            fuelType: document.getElementById('vehicleFuelType').value,
            consumption: parseFloat(document.getElementById('vehicleConsumption').value),
            cityConsumption: document.getElementById('vehicleCityConsumption').value ? 
                parseFloat(document.getElementById('vehicleCityConsumption').value) : null,
            highwayConsumption: document.getElementById('vehicleHighwayConsumption').value ? 
                parseFloat(document.getElementById('vehicleHighwayConsumption').value) : null,
            year: parseInt(document.getElementById('vehicleYear').value),
            licensePlate: document.getElementById('vehicleLicensePlate').value.trim()
        };
        
        const index = parseInt(document.getElementById('vehicleIndex').value);
        
        if (index >= 0) {
            // Update existing vehicle
            StorageManager.updateVehicle(index, vehicleData);
        } else {
            // Add new vehicle
            StorageManager.saveVehicle(vehicleData);
        }
        
        // Go back to vehicles list
        goBackToVehicles();
    }

    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
</script>
