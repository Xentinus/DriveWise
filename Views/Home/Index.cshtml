@{
    ViewData["Title"] = "Home";
}

<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="utf-8" />
</head>
<body>

<!-- Warning message displayed when JavaScript is disabled -->
<noscript>
    <div class="alert alert-danger d-flex align-items-center position-fixed w-100 h-100" style="top: 0; left: 0; z-index: 9999; background-color: rgba(220, 53, 69, 0.95);">
        <div class="container text-center">Megos
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <i class="bi bi-exclamation-triangle-fill" style="font-size: 4rem; color: white; margin-bottom: 1rem;"></i>
                    <h2 class="text-white mb-3">JavaScript szükséges!</h2>
                    <p class="text-white fs-5 mb-4">
                        A DriveWise alkalmazás működéséhez JavaScript engedélyezése szükséges a böngészőjében.
                    </p>
                    <div class="text-white">
                        <h4 class="mb-3">JavaScript engedélyezése:</h4>
                        <ul class="list-unstyled">
                            <li class="mb-2"><strong>Chrome/Edge:</strong> Beállítások → Adatvédelem és biztonság → Webhely beállításai → JavaScript</li>
                            <li class="mb-2"><strong>Firefox:</strong> about:config → javascript.enabled → true</li>
                            <li class="mb-2"><strong>Safari:</strong> Beállítások → Biztonság → JavaScript engedélyezése</li>
                        </ul>
                        <p class="mt-4">
                            <small>JavaScript engedélyezése után frissítse az oldalt (F5).</small>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</noscript>

<!-- Content that requires JavaScript - hidden by default, shown by JavaScript -->
<div id="jsRequiredContent" style="display: none;">
    <!-- This content will be shown only when JavaScript is enabled -->
    <div class="d-none">
        <!-- Hidden content that confirms JavaScript is working -->
        <h1>DriveWise Térkép Alkalmazás</h1>
        <p>JavaScript engedélyezve - alkalmazás kész.</p>
    </div>
</div>

<!-- JavaScript to show content when JS is enabled -->
<script>
    // Immediately show the content when JavaScript is available
    document.addEventListener('DOMContentLoaded', function() {
        const jsContent = document.getElementById('jsRequiredContent');
        if (jsContent) {
            jsContent.style.display = 'block';
        }
        
        // Handle shared route error if any
        @if (!string.IsNullOrEmpty(ViewBag.SharedRouteError as string))
        {
            <text>
            console.error('[index] Shared route error: @ViewBag.SharedRouteError');
            
            // Show error to user
            setTimeout(() => {
                if (window.RouteCard && window.RouteCard.showToast) {
                    window.RouteCard.showToast('@ViewBag.SharedRouteError', 'error');
                } else if (window.SharedRouteHandler && window.SharedRouteHandler.showToast) {
                    window.SharedRouteHandler.showToast('@ViewBag.SharedRouteError', 'error');
                } else {
                    alert('@ViewBag.SharedRouteError');
                }
            }, 1000);
            </text>
        }
    });
    
    // Alternative immediate execution (in case DOM is already loaded)
    const jsContent = document.getElementById('jsRequiredContent');
    if (jsContent) {
        jsContent.style.display = 'block';
    }
</script>

</body>
</html>
