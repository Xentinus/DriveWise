root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cs,js,html,css,razor,cshtml}]
charset = utf-8

[*.cs]
indent_size = 4

[*.{js,html,css,json}]
indent_size = 2

[*.{razor,cshtml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false