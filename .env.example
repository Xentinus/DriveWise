# DriveWise Configuration
# Copy this file to .env and fill in your values

# Raspberry Pi Configuration
RPI_HOST=10.0.0.250
RPI_USER=pi
RPI_PASSWORD=your_password_here

# Docker Configuration
IMAGE_NAME=drivewise
CONTAINER_NAME=drivewise-app

# Docker Registry (optional - leave empty for local builds only)
# Examples:
#   - Docker Hub: docker.io/yourusername
#   - GitHub Container Registry: ghcr.io/yourusername
REGISTRY=

# Container Port
CONTAINER_PORT=8800
